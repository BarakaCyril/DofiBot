# Copy this file to .env and fill in the values.
# Never commit .env or paste these keys in the group chat.

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Discord Developer Portal > your app > General Information > Application ID
DISCORD_CLIENT_ID=
# Right-click the test server > Copy Server ID (needs Developer Mode on)
DISCORD_GUILD_ID=

# Needed from step 5
ELEVENLABS_API_KEY=
# Optional. Leave blank for the defaults.
# Model: eleven_v3 (default, supports Kiswahili) or eleven_flash_v2_5 (faster)
ELEVENLABS_MODEL=
# Voice for people who haven't used /myvoice (default: George)
ELEVENLABS_DEFAULT_VOICE_ID=
# Text channel whose messages are spoken in the call (default: silent-seat)
SILENT_SEAT_CHANNEL=
# Scribe model for transcription: scribe_v1 (default, faster) or scribe_v2
ELEVENLABS_STT_MODEL=
# Text channel where call transcripts are posted (default: transcript)
TRANSCRIPT_CHANNEL=
# Needed from step 7
ANTHROPIC_API_KEY=
