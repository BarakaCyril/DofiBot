# Copy this file to .env and fill in the values.
# Never commit .env or paste these keys in the group chat.

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Discord Developer Portal > your app > General Information > Application ID
DISCORD_CLIENT_ID=
# Right-click the test server > Copy Server ID (needs Developer Mode on)
DISCORD_GUILD_ID=

# Needed from step 5
ELEVENLABS_API_KEY=
# Needed from step 7
ANTHROPIC_API_KEY=
