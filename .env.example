# Copy this file to .env and fill in the values.
# Never commit .env or paste these keys in the group chat.

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Discord Developer Portal > your app > General Information > Application ID
DISCORD_CLIENT_ID=
# Right-click the test server > Copy Server ID (needs Developer Mode on)
DISCORD_GUILD_ID=

# Needed from step 5
ELEVENLABS_API_KEY=
# Optional. Leave blank for the defaults.
# Model: eleven_v3 (default, supports Kiswahili) or eleven_flash_v2_5 (faster)
ELEVENLABS_MODEL=
# Voice for people who haven't used /myvoice (default: George)
ELEVENLABS_DEFAULT_VOICE_ID=
# Text channel whose messages are spoken in the call (default: silent-seat)
SILENT_SEAT_CHANNEL=
# Scribe model for transcription: scribe_v1 (default, faster) or scribe_v2
ELEVENLABS_STT_MODEL=
# Text channel where call transcripts are posted (default: transcript)
TRANSCRIPT_CHANNEL=
# Grok (xAI): cleans up the transcript after a call. Leave blank to skip clean-up.
# Get a key at console.x.ai.
XAI_API_KEY=
# Optional: which Grok model to use (default: grok-4)
XAI_MODEL=

# Africa's Talking SMS: alerts when a call starts and ends. Leave blank to skip.
# To test for free, use AT_USERNAME=sandbox with the sandbox API key, and
# watch messages arrive in the Africa's Talking sandbox simulator.
AT_USERNAME=
AT_API_KEY=
# Optional sender name shown on the SMS (must be approved by Africa's Talking)
AT_SENDER_ID=
# Phone numbers to alert, comma-separated: +254712345678,+254798765432
SMS_TO=
